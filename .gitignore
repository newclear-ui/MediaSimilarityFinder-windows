# Build outputs (rooted: must not match docs/build-history/)
/build-*/
/build/
/out/
/.vs/
# Same for the unpacked source tree
/src_unpacked/build-*/
/src_unpacked/build/
/src_unpacked/out/
/src_unpacked/.vs/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Testing/

# vcpkg project-local tree (regenerable via scripts/build_windows_*.ps1)
/vcpkg_installed/
/src_unpacked/vcpkg_installed/

# Portable packaging outputs (regenerable via scripts/package_portable.ps1)
/portable-release/
/src_unpacked/portable-release/
MediaSimilarityFinder-v*-Portable-*.zip

# Source backup zips (regenerable via src_unpacked/scripts/backup_src.ps1).
# These are byte-identical to GitHub by construction, so committing them would
# only duplicate the repo. Excluded so a backup can never nest inside the next.
/backup/

# Runtime index/cache (program-owned, machine-local)
/Index/
/Cache/
/src_unpacked/Index/
/src_unpacked/Cache/
*.sqlite-journal

# D8 standard dataset (regenerable via scripts/prepare_dataset.ps1).
# Binary fixtures are never committed; the expected fingerprint lives in
# src_unpacked/docs/test_sample_img_vid.md and the build-history docs.
/test_sample_img_vid/
/src_unpacked/test_sample_img_vid/
*.fingerprint.json

# Per-scan scratch index dirs created by the D8 review probe
/test_sample_img_vid_appdir*/
